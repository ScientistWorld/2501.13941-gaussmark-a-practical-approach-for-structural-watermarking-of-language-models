        "mistral_unwatermarked": {"type": "baseline",   "gsm8k_accuracy": 0.4291},
        "llama_watermarked":      {"type": "proposed",  "gsm8k_accuracy": 0.6111},
        "llama_unwatermarked":    {"type": "baseline",   "gsm8k_accuracy": 0.6300},
        "phi_watermarked":        {"type": "proposed",  "gsm8k_accuracy": 0.8552},
        "phi_unwatermarked":      {"type": "baseline",   "gsm8k_accuracy": 0.8423}
      }
    },
    "robustness_corruptions": {
      "description": "Robustness of watermark detection to token-level corruptions (Figure 4a-c). Detection rate should remain nontrivial after up to 50% of tokens are corrupted.",
      "weight": 0.05,
      "primary_metric": "detection_rate_fpr_0.05",
      "metrics": {
        "detection_rate_fpr_0.05": {"higher_is_better": true, "coefficient": 1.0}
      },
      "results": {
        "mistral_no_corruption":        {"type": "proposed", "detection_rate_fpr_0.05": 0.97},
        "mistral_10pct_insertion":       {"type": "proposed", "detection_rate_fpr_0.05": 0.80},
        "mistral_25pct_insertion":       {"type": "proposed", "detection_rate_fpr_0.05": 0.55},
        "mistral_50pct_insertion":       {"type": "proposed", "detection_rate_fpr_0.05": 0.30}
