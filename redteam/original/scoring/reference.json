{
  "experiments": {
    "watermark_detection_mistral": {
      "description": "GaussMark detection on Mistral-7B with 200 generated tokens. Primary metric: TPR at FPR=0.05. Paper reports ~62% at FPR=0.05 and ~40% at FPR=0.01 for 200 tokens (Figure 2a). Table 2 gives variance sigma^2=1e-5 for Mistral, so this reproduction uses standard deviation sigma=sqrt(1e-5). C4 cross-entropy ratio is included as a quality constraint from Table 3.",
      "weight": 0.50,
      "primary_metric": "detection_rate_fpr_0.05",
      "metrics": {
        "detection_rate_fpr_0.05": {"higher_is_better": true, "coefficient": 1.0},
        "detection_rate_fpr_0.01": {"higher_is_better": true, "coefficient": 0.6},
        "median_p_value": {"higher_is_better": false, "coefficient": 0.2},
        "mean_p_value": {"higher_is_better": false, "coefficient": 0.15, "description": "Mean watermarked p-value; complements the median by catching methods that only improve a narrow subset of samples."},
        "auc": {"higher_is_better": true, "coefficient": 0.3},
        "detection_margin_fpr_0.05": {"higher_is_better": true, "coefficient": 0.4, "description": "Watermarked detection rate minus unwatermarked detection rate at p<0.05; rewards separation without inflated false positives."},
        "unwatermarked_detection_rate_fpr_0.05": {"higher_is_better": false, "coefficient": -1.0},
        "unwatermarked_detection_rate_fpr_0.01": {"higher_is_better": false, "coefficient": -0.5},
        "c4_cross_entropy_ratio": {"higher_is_better": false, "coefficient": -0.5},
        "c4_cross_entropy_delta": {"higher_is_better": false, "coefficient": -0.2},
        "generation_time_ratio": {"higher_is_better": false, "coefficient": -0.1}
      },
      "results": {
        "gaussmark_200_tokens": {
          "type": "proposed",
          "detection_rate_fpr_0.05": 0.62,
          "detection_rate_fpr_0.01": 0.40,
          "median_p_value": 0.09,
          "auc": 0.85,
          "unwatermarked_detection_rate_fpr_0.05": 0.05,
          "unwatermarked_detection_rate_fpr_0.01": 0.01,
          "c4_cross_entropy_ratio": 1.0097,
          "c4_cross_entropy_delta": 0.0186,
          "generation_time_ratio": 1.0
        },
        "unwatermarked": {
          "type": "baseline",
          "detection_rate_fpr_0.05": 0.05,
          "detection_rate_fpr_0.01": 0.01,
          "median_p_value": 0.50,
          "auc": 0.50,
          "c4_cross_entropy_ratio": 1.0,
          "c4_cross_entropy_delta": 0.0,
          "generation_time_ratio": 1.0
        }
      }
    },
